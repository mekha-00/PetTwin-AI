# Normalise line endings so the Linux deploy image and Windows dev boxes agree.
* text=auto eol=lf

# Windows-only scripts keep CRLF.
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets are never line-ending converted.
*.pdf binary
*.xlsx binary
*.onnx binary
*.npy binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
