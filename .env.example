# PetTwin AI — environment template
# Copy to `.env` at the repository root and fill in your own values.
#   cp .env.example .env
# `.env` is git-ignored. NEVER commit real keys or passwords.
#
# Every value below is a PLACEHOLDER. No keys or credentials are bundled here.

# ── Application ──────────────────────────────────────────────────────────
APP_NAME="PetTwin AI API"
APP_VERSION="0.3.0"
DEBUG=True
API_PREFIX=/api

# ── CORS ─────────────────────────────────────────────────────────────────
# Comma-separated allowlist. A wildcard (*) is never used because the API is
# token-authenticated. For production, list your real frontend origins only.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Database (PostgreSQL) ───────────────────────────────────────────────
# The connection string is assembled from these five values.
# It is NEVER written in source code, never committed, and never exposed to
# the frontend.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=pettwin

# TLS mode for the assembled connection string. Hosted Postgres (Render, Neon,
# Supabase) requires TLS; "prefer" is harmless locally. Set "require" to force it.
POSTGRES_SSLMODE=prefer

# Optional full-connection-string override. When set, it wins over the
# POSTGRES_* parts above — paste a hosted provider's exact URL here if its shape
# does not map onto the parts. Example:
#   DATABASE_URL_OVERRIDE=postgresql://user:pass@host/db?sslmode=require
DATABASE_URL_OVERRIDE=

# Creates tables on startup from the SQLAlchemy metadata.
# Keep FALSE in normal use. Set TRUE only for a throwaway local database.
# No Alembic migrations: `pet_allergies` is created by create_all().
DB_AUTO_CREATE=False

# ── JWT / access tokens ──────────────────────────────────────────────────
# REQUIRED. Generate a fresh value with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# The app refuses to start if this is empty or shorter than 32 characters.
# Rotating it invalidates every issued token.
SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ISSUER=pettwin-api
JWT_AUDIENCE=pettwin-frontend
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Password hashing ─────────────────────────────────────────────────────
# bcrypt cost factor. Higher is slower and safer.
# 12 is a reasonable development value; 12-13 for production.
BCRYPT_ROUNDS=12

# ── Groq (LLM for RAG answer generation and agents) ──────────────────────
# Consumed by the BACKEND ONLY. Never exposed to the frontend.
# Optional: without a key the app runs fully, and /api/rag/query returns 503.
# Create a key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# ── RAG index ────────────────────────────────────────────────────────────
# Build the document index during startup. The first build embeds every PDF
# chunk and takes a couple of minutes; afterwards it is cached in-process.
# Warming at boot keeps the first /api/rag/query responsive. Set to false to
# start instantly and pay the cost on the first query instead.
RAG_WARMUP_ON_STARTUP=true

# ── Frontend (Vite) ──────────────────────────────────────────────────────
# Base URL the React app calls. This is a URL, not a secret.
VITE_API_BASE_URL=http://localhost:8000/api
